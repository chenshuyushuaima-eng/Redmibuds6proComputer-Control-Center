<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>WinExe</OutputType><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>MiBudsControl</AssemblyName><RootNamespace>BudsControl</RootNamespace>
    <PlatformTarget>x64</PlatformTarget><OutputPath>..\dist\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FrameworkPath>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319</FrameworkPath>
    <MetadataPath>$(WINDIR)\System32\WinMetadata</MetadataPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="System.Xaml"/>
    <Reference Include="PresentationCore"/><Reference Include="PresentationFramework"/><Reference Include="WindowsBase"/>
    <Reference Include="System.Runtime"><HintPath>$(FrameworkPath)\System.Runtime.dll</HintPath></Reference>
    <Reference Include="System.Runtime.InteropServices.WindowsRuntime"><HintPath>$(FrameworkPath)\System.Runtime.InteropServices.WindowsRuntime.dll</HintPath></Reference>
    <Reference Include="System.Threading.Tasks"><HintPath>$(FrameworkPath)\System.Threading.Tasks.dll</HintPath></Reference>
    <Reference Include="System.Collections"><HintPath>$(FrameworkPath)\System.Collections.dll</HintPath></Reference>
    <Reference Include="System.ObjectModel"><HintPath>$(FrameworkPath)\System.ObjectModel.dll</HintPath></Reference>
    <Reference Include="Windows.Foundation"><HintPath>$(MetadataPath)\Windows.Foundation.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Devices"><HintPath>$(MetadataPath)\Windows.Devices.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Networking"><HintPath>$(MetadataPath)\Windows.Networking.winmd</HintPath><Private>False</Private></Reference>
    <Reference Include="Windows.Storage"><HintPath>$(MetadataPath)\Windows.Storage.winmd</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs"/><Compile Include="Program.cs"/><Compile Include="MainWindow.cs"/><Compile Include="Protocol.cs"/><Compile Include="BudsClient.cs"/><Compile Include="Preferences.cs"/><Compile Include="FitAudio.cs"/>
    <Content Include="..\assets\fitness_detect.wav" Condition="Exists('..\assets\fitness_detect.wav') And '$(PublicRelease)' != 'true'"><Link>fitness_detect.wav</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Compile Include="..\tools\BudsAuthentication.cs"><Link>BudsAuthentication.cs</Link></Compile>
    <Compile Include="..\tools\WinrtAwaiter.cs"><Link>WinrtAwaiter.cs</Link></Compile>
    <EmbeddedResource Include="Theme.xaml"><LogicalName>Theme.xaml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\tray-white.ico"><LogicalName>TrayWhite.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\assets\tray-dark.ico"><LogicalName>TrayDark.ico</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
